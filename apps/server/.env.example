# 由 @homurajs/core defineConfig 生成（配置即文档）

# 监听端口
PORT=3000

# 监听地址（缺省 0.0.0.0）
HOST=

# 是否在反向代理后（决定 cookie Secure 与 X-Forwarded-* 可信度）
TRUST_PROXY=false

# 数据方言：'sqlite' | 'pg'（缺省 sqlite）
DB_DIALECT=sqlite

# sqlite 数据库文件路径（dialect=sqlite 时用）
DB_PATH=./data/app.db

# PostgreSQL 连接串（dialect=pg 时必填）
DATABASE_URL=<redacted>

# session HS256 签名密钥（>=32 bytes，必填）
# 留空或保持 <redacted> 时，`pnpm dev/seed/start` 会经 ensure-env 自动生成并落盘（见 src/ensure-env.ts）
SESSION_SECRET=<redacted>

# local-fs 存储后端根目录（当前 DB 后端不读，保留备用）
STORAGE_ROOT=./data/files

# 前端静态资源目录（缺省由 RuntimeAdapter.assetsDir 按形态算）
HOMURA_ASSETS_DIR=

# CORS 允许的来源（逗号分隔）；修复现有硬编码 localhost 缺陷
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 日志级别：'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info

